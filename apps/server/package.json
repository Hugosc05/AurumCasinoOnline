{
  "name": "@aurum/server",
  "version": "1.10.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --no-warnings=ExperimentalWarning --clear-screen=false src/index.ts",
    "start": "tsx --no-warnings=ExperimentalWarning src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx --no-warnings=ExperimentalWarning src/cli/migrate.ts",
    "db:seed": "tsx --no-warnings=ExperimentalWarning src/cli/seed.ts",
    "admin:create": "tsx --no-warnings=ExperimentalWarning src/cli/createAdmin.ts",
    "admin:reset-2fa": "tsx --no-warnings=ExperimentalWarning src/cli/resetMfa.ts",
    "db:import": "tsx --no-warnings=ExperimentalWarning src/cli/importPostgres.ts",
    "db:backup": "tsx --no-warnings=ExperimentalWarning src/cli/backup.ts"
  },
  "dependencies": {
    "@aurum/engine": "*",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "tsx": "4.23.15",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.1"
  }
}
