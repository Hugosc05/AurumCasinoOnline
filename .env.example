# Copia este archivo como .env (en la raíz del proyecto) y ajusta lo que necesites.
# Ningún valor de este archivo es un secreto real. No subas tu .env a GitHub.

# Entorno: development | production | test
NODE_ENV=development

# Servidor HTTP + WebSocket
HOST=127.0.0.1
PORT=3001

# Base de datos SQLite (ruta relativa a apps/server). Se crea sola al arrancar.
DATABASE_PATH=data/aurum.db

# Orígenes permitidos para CORS y para la comprobación anti-CSRF (separados por comas).
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# Cookies "Secure": actívalo solo si sirves la aplicación por HTTPS.
# Por defecto: true si NODE_ENV=production, false en desarrollo.
# COOKIE_SECURE=false

# Duración de la sesión (horas, renovación deslizante)
SESSION_TTL_HOURS=168

# Saldo virtual inicial de cada cuenta nueva
STARTING_BALANCE=10000

# Límites anti-abuso por IP
REGISTER_LIMIT_PER_HOUR=10
LOGIN_LIMIT_PER_15MIN=30

# Detrás de un proxy inverso (para leer la IP real)
TRUST_PROXY=false

# Nivel de registro: debug | info | warn | error
LOG_LEVEL=info

# Solo para la CLI de creación de administrador (opcional; si no, se pide por teclado).
# ADMIN_PASSWORD=
